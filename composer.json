{
    "name": "norialabs/approvals",
    "description": "Maker-checker approvals for Laravel. Holds Eloquent creates, updates and deletes, pivot writes and custom actions until the right people approve, with multi-step and grouped approvers, rule-based policies, delegation, expiry, escalation, an audit trail, tenancy, and configurable keys and tables.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "approvals",
        "maker-checker",
        "four-eyes",
        "dual-control",
        "workflow"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Noria\\Approvals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noria\\Approvals\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures/models.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noria\\Approvals\\ApprovalsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@hooks"
        ],
        "post-update-cmd": [
            "@hooks"
        ],
        "hooks": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "lint": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "test": "@php vendor/bin/pest",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
